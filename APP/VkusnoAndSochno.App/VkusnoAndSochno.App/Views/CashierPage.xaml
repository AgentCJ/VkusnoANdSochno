<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VkusnoAndSochno.App.Views.CashierPage"
             Title="Касса — Вкусно и сочно">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="{Binding StatusMessage}"
               FontSize="18"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="DarkSlateGray"/>

        <Button Text="🆕 Создать новый заказ"
                Command="{Binding CreateNewOrderCommand}"/>

        <Button Text="🍔 Добавить Гамбургер (150 ₽)"
                Command="{Binding AddBurgerCommand}"/>

        <Button Text="💳 Оплатить заказ"
                Command="{Binding CloseOrderCommand}"
                BackgroundColor="#4CAF50"/>

    </VerticalStackLayout>
</ContentPage>