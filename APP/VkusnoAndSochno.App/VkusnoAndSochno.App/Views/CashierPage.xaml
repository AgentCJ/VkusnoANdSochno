<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.CashierPage"
             Title="Касса"
             BackgroundColor="#F5F5F5">

    <Grid ColumnDefinitions="2*, 1*" Padding="10" ColumnSpacing="10">

        <!-- Левая часть: меню и управление заказом -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" RowSpacing="10">

            <!-- Панель управления заказом -->
            <Border Grid.Row="0" Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="🆕 Новый заказ" Command="{Binding CreateNewOrderCommand}" BackgroundColor="#2196F3" TextColor="White"/>

                    <Button Grid.Column="1" 
                            Text="{Binding GlobalQuantity, StringFormat='Кол-во: {0}'}" 
                            Command="{Binding ChangeQuantityCommand}" 
                            IsEnabled="{Binding IsOrderCreated}"
                            BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" 
                            WidthRequest="100" HeightRequest="40" CornerRadius="5" Padding="0"/>

                    <HorizontalStackLayout Grid.Column="3" Spacing="10">
                        <Button Text="❌ Отменить" Command="{Binding CancelOrderCommand}" BackgroundColor="#F44336" TextColor="White" IsVisible="{Binding IsOrderCreated}"/>
                        <Button Text="🕒 История" Command="{Binding GoToHistoryCommand}" BackgroundColor="#9C27B0" TextColor="White"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Поиск и сортировка -->
            <Grid Grid.Row="1" ColumnDefinitions="*, 160, 110" ColumnSpacing="10">
                <Border Grid.Column="0" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <SearchBar Placeholder="Поиск блюда..." Text="{Binding SearchText}" BackgroundColor="Transparent" CancelButtonColor="Gray"/>
                </Border>

                <Button Grid.Column="1" 
                        Text="{Binding SelectedSort, StringFormat='🔽 {0}'}" 
                        Command="{Binding ChangeSortCommand}" 
                        BackgroundColor="#E3F2FD" TextColor="#1565C0" FontSize="13" FontAttributes="Bold" 
                        HeightRequest="40" WidthRequest="160" CornerRadius="5" Padding="5,0"/>

                <Button Grid.Column="2" 
                        Text="🔄 Обновить" 
                        Command="{Binding LoadMenuCommand}" 
                        BackgroundColor="#2196F3" TextColor="White" FontSize="12" 
                        HeightRequest="40" WidthRequest="110" Padding="0" CornerRadius="5"/>
            </Grid>

            <!-- Сетка с блюдами -->
            <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredMenu}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:DishDto">
                        <Border Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="LightGray">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCartCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid>
                                <VerticalStackLayout>
                                    <Label Text="{Binding DishName}" FontAttributes="Bold" FontSize="14" TextColor="Black" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2"/>
                                    <Label Text="{Binding Category}" FontSize="10" TextColor="Gray" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Price, StringFormat='{0} ₽'}" TextColor="#4CAF50" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                                </VerticalStackLayout>

                                <!-- Блокировка блюда при отсутствии ингредиентов -->
                                <Grid IsVisible="{Binding IsAvailable, Converter={StaticResource InverseBoolConverter}}" 
                                      BackgroundColor="#B3FFFFFF" HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Label Text="НЕТ ИНГРЕДИЕНТОВ" TextColor="#D32F2F" FontAttributes="Bold" 
                                           HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Правая часть: корзина -->
        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="0">
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
                <Label Grid.Row="0" Text="Текущий чек" FontSize="18" FontAttributes="Bold" TextColor="Black"/>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Cart}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:CartItemDto">
                            <Grid RowDefinitions="Auto, 1" Padding="0, 5">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFromCartCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="5" Margin="5,0">
                                    <Label Grid.Column="0" Text="{Binding DishName}" TextColor="Black" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                    <Button Grid.Column="1" Text="−" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseQuantityCommand}" CommandParameter="{Binding .}" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="18" FontAttributes="Bold" WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="0" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Quantity}" TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="Center" WidthRequest="25"/>
                                    <Label Grid.Column="3" Text="{Binding TotalPrice, StringFormat='{0} ₽'}" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" HorizontalTextAlignment="End" WidthRequest="70"/>
                                </Grid>
                                <BoxView Grid.Row="1" Color="LightGray" HeightRequest="1" HorizontalOptions="Fill" Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Итого:" FontSize="18" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{0:N2} ₽'}" FontSize="22" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center"/>
                    </Grid>
                    <Button Text="💳 Оплатить" Command="{Binding PayOrderCommand}" BackgroundColor="#4CAF50" FontSize="16" HeightRequest="50"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>