<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.CookPage"
             Title="Кухня"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="10">

        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
            <Label Grid.Column="0" Text="Активные заказы" FontAttributes="Bold" FontSize="20" TextColor="Black" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="История" Command="{Binding GoToHistoryCommand}" BackgroundColor="#9C27B0" TextColor="White" FontSize="12" HeightRequest="35" Padding="10,0"/>
            <Button Grid.Column="2" Text="Обновить" Command="{Binding LoadOrdersCommand}" BackgroundColor="#2196F3" TextColor="White" FontSize="12" HeightRequest="35" Padding="10,0"/>
        </Grid>

        <!-- Список заказов -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadOrdersCommand}">
            <CollectionView ItemsSource="{Binding ActiveOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:ActiveOrderDto">
                        <Border Margin="0,5" Padding="15" BackgroundColor="White" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="LightGray">
                            <VerticalStackLayout Spacing="10">

                                <!-- Шапка заказа: Номер, Время создания, Таймер и Сумма -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding IdOrder, StringFormat='Заказ №{0}'}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                        <Label Text="{Binding OrderTime, StringFormat='Создан: {0:HH:mm:ss}'}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding TotalAmount, StringFormat='{0} ₽'}" TextColor="#4CAF50" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="End"/>

                                        <!-- Таймер с изменением цвета -->
                                        <Label Text="{Binding TimeElapsed}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <!-- Если время превышено (красный) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="TextColor" Value="#F44336" />
                                                </DataTrigger>
                                                <!-- Если время в норме (синий) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="False">
                                                    <Setter Property="TextColor" Value="#2196F3" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Статус -->
                                <Border BackgroundColor="#FFF3E0" StrokeShape="RoundRectangle 5" Padding="8,4" HorizontalOptions="Start">
                                    <Label Text="{Binding Status, StringFormat='Статус: {0}'}" TextColor="#FF9800" FontAttributes="Bold" FontSize="12"/>
                                </Border>

                                <BoxView HeightRequest="1" Color="#EEEEEE"/>

                                <!-- Состав заказа -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="5">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:OrderItemDto">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding DishName}" TextColor="Black" FontSize="15"/>
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" TextColor="#1976D2" FontAttributes="Bold" FontSize="15"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" Color="#EEEEEE"/>

                                <!-- Кнопки управления -->
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Margin="0,5,0,0">
                                    <Button Text="Начать готовить" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StartCookingCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" CornerRadius="8"
                                            IsVisible="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter='оплачен'}"/>

                                    <Button Text="Заказ готов" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FinishCookingCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"
                                            IsVisible="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter='готовится'}"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>