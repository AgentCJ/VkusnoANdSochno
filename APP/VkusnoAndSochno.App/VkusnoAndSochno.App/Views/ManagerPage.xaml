<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.ManagerPage"
             Title="Отчеты (Управляющий)">
    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Панель фильтров -->
        <Border Grid.Row="0" Padding="10" Stroke="Gray" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="10">
                <Label Text="Отчет по продажам" FontAttributes="Bold" FontSize="18"/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="С:" FontSize="12"/>
                        <DatePicker Date="{Binding FromDate}" Format="dd.MM.yyyy" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="По:" FontSize="12"/>
                        <DatePicker Date="{Binding ToDate}" Format="dd.MM.yyyy" />
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Сформировать отчет" Command="{Binding GenerateReportCommand}" BackgroundColor="#2196F3"/>
                <Label Text="{Binding TotalSummary}" FontAttributes="Bold" TextColor="Green" HorizontalOptions="Center" FontSize="16"/>
            </VerticalStackLayout>
        </Border>

        <!-- Заголовки таблицы -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Padding="10,0">
            <Label Text="Филиал" FontAttributes="Bold" Grid.Column="0"/>
            <Label Text="Заказов" FontAttributes="Bold" Grid.Column="1" WidthRequest="80" HorizontalTextAlignment="Center"/>
            <Label Text="Выручка" FontAttributes="Bold" Grid.Column="2" WidthRequest="100" HorizontalTextAlignment="End"/>
        </Grid>

        <!-- Таблица результатов -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding GenerateReportCommand}">
            <CollectionView ItemsSource="{Binding ReportData}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:SalesReportDto">
                        <Border Margin="0,3" Padding="10" StrokeThickness="1" Stroke="DarkGray" StrokeShape="RoundRectangle 5">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding BranchName}" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding AvgOrder, StringFormat='Средний чек: {0:N2} ₽'}" FontSize="11" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding OrdersCount}" TextColor="#2196F3" FontAttributes="Bold" 
                                       WidthRequest="80" HorizontalTextAlignment="Center" VerticalOptions="Center"/>

                                <Label Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='{0:N2} ₽'}" TextColor="#4CAF50" FontAttributes="Bold" 
                                       WidthRequest="100" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>