<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.ManagerPage"
             Title="Отчеты (Управляющий)"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Панель кнопок -->
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnSpacing="10" HorizontalOptions="Start">
                <Button Grid.Column="0" Text="🍔 Управление меню" Clicked="OnMenuManagementClicked" BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                <Button Grid.Column="1" Text="📦 Создание продуктов" Clicked="OnProductManagementClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                <Button Grid.Column="2" Text="📅 Управление графиком" Clicked="OnScheduleManagementClicked" BackgroundColor="#9C27B0" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                <Button Grid.Column="3" Text="📄 Скачать отчет (DOCX)" Command="{Binding GenerateDetailedDocxCommand}" BackgroundColor="#2B579A" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                <Button Grid.Column="4" Text="🕒 История заказов" Clicked="OnHistoryClicked" BackgroundColor="#607D8B" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
            </Grid>

            <Label Text="Сводка за сегодня" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#E3F2FD" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="💰 Выручка" TextColor="#1565C0" FontAttributes="Bold" FontSize="12"/>
                        <Label Text="{Binding TodayRevenue, StringFormat='{0:N0} ₽'}" TextColor="#0D47A1" FontAttributes="Bold" FontSize="18"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🛍 Заказы" TextColor="#2E7D32" FontAttributes="Bold" FontSize="12"/>
                        <Label Text="{Binding TodayOrdersCount}" TextColor="#1B5E20" FontAttributes="Bold" FontSize="18"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#FFF3E0" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🔥 Хит дня" TextColor="#E65100" FontAttributes="Bold" FontSize="12"/>
                        <Label Text="{Binding TopDish}" TextColor="#BF360C" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>

            <Label Text="Детальный отчет за период" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
            <Border Padding="10" Stroke="LightGray" StrokeShape="RoundRectangle 8" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="С:" FontSize="12" TextColor="Gray"/>
                            <DatePicker Date="{Binding FromDate}" Format="dd.MM.yyyy" TextColor="Black"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="По:" FontSize="12" TextColor="Gray"/>
                            <DatePicker Date="{Binding ToDate}" Format="dd.MM.yyyy" TextColor="Black"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Сформировать отчет" Command="{Binding GenerateReportCommand}" BackgroundColor="#2196F3" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalSummary}" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center" FontSize="14"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, Auto, Auto" Padding="10,0" Margin="0,10,0,0">
                <Label Text="Филиал" FontAttributes="Bold" Grid.Column="0" TextColor="Black"/>
                <Label Text="Заказов" FontAttributes="Bold" Grid.Column="1" WidthRequest="80" HorizontalTextAlignment="Center" TextColor="Black"/>
                <Label Text="Выручка" FontAttributes="Bold" Grid.Column="2" WidthRequest="100" HorizontalTextAlignment="End" TextColor="Black"/>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReportData}" Spacing="5">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:SalesReportDto">
                        <Border Margin="0" Padding="10" StrokeThickness="1" Stroke="LightGray" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding BranchName}" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Text="{Binding AvgOrder, StringFormat='Средний чек: {0:N2} ₽'}" FontSize="11" TextColor="Gray"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding OrdersCount}" TextColor="#2196F3" FontAttributes="Bold" WidthRequest="80" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='{0:N2} ₽'}" TextColor="#4CAF50" FontAttributes="Bold" WidthRequest="100" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>