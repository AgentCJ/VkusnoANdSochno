<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VkusnoAndSochno.App.Views.LoginPage"
             Title="Вход в систему"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto, *">

        <!-- Карточка по центру экрана -->
        <Border Grid.Row="1" BackgroundColor="White" Padding="30" 
                StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="LightGray"
                WidthRequest="400" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="20">
                <Label Text="АИС «Вкусно и сочно»" FontSize="26" TextColor="Black" 
                       HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="Авторизация сотрудника" FontSize="14" TextColor="Gray" 
                       HorizontalOptions="Center" Margin="0,0,0,10"/>

                <Border Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <Entry x:Name="LoginEntry" Placeholder="Логин" TextColor="Black" PlaceholderColor="#666666" Margin="5,0" BackgroundColor="Transparent"/>
                </Border>

                <Border Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" TextColor="Black" PlaceholderColor="#666666" Margin="5,0" BackgroundColor="Transparent"/>
                </Border>

                <Label x:Name="ErrorLabel" TextColor="Red" HorizontalOptions="Center" FontAttributes="Bold"/>

                <Button Text="Войти в систему" Clicked="OnLoginClicked" BackgroundColor="#2196F3" 
                        TextColor="White" FontAttributes="Bold" FontSize="16" HeightRequest="50" CornerRadius="8" Margin="0,10,0,0"/>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10"/>

                <Label Text="Тестовые аккаунты:&#10;cashier1 / hash_2 (кассир)&#10;cook1 / hash_3 (повар)" 
                       FontSize="12" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>