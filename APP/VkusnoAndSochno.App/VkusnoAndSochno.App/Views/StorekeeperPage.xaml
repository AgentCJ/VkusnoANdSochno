<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.StorekeeperPage"
             Title="Склад"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Форма поставки -->
        <Border Grid.Row="0" Padding="15" BackgroundColor="#E3F2FD" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#90CAF9">
            <VerticalStackLayout Spacing="10">
                <Label Text="Регистрация поставки" FontAttributes="Bold" FontSize="18" TextColor="#1565C0"/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <!-- Ингредиент -->
                    <Border Grid.Column="0" Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                        <Picker Title="Ингредиент" ItemsSource="{Binding Ingredients}" 
                                ItemDisplayBinding="{Binding IngredientName}" 
                                SelectedItem="{Binding SelectedIngredient}"
                                TextColor="Black" TitleColor="#666666" Margin="5,0" BackgroundColor="Transparent"/>
                    </Border>

                    <!-- Поставщик -->
                    <Border Grid.Column="1" Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                        <Picker Title="Поставщик" ItemsSource="{Binding Suppliers}" 
                                ItemDisplayBinding="{Binding SupplierName}" 
                                SelectedItem="{Binding SelectedSupplier}"
                                TextColor="Black" TitleColor="#666666" Margin="5,0" BackgroundColor="Transparent"/>
                    </Border>
                </Grid>

                <!-- Количество -->
                <Border Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <Entry Placeholder="Количество (например: 10.5)" Keyboard="Numeric" 
                           Text="{Binding QuantityText}" 
                           TextColor="Black" PlaceholderColor="#666666" Margin="5,0" BackgroundColor="Transparent"/>
                </Border>

                <Button Text="Оформить поставку" Command="{Binding RegisterSupplyCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
                <Label Text="{Binding StatusMessage}" TextColor="#1565C0" HorizontalOptions="Center" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

        <!-- Заголовок и кнопка обновления -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
            <Label Grid.Column="0" Text="Остатки на складе" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="🔄 Обновить" Command="{Binding LoadDataCommand}" 
                    BackgroundColor="#2196F3" TextColor="White" FontSize="12" HeightRequest="35" Padding="10,0"/>
        </Grid>

        <!-- Таблица остатков -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding StockList}">

                <!-- EmptyView заставляет список перерисовываться -->
                <CollectionView.EmptyView>
                    <Label Text="Загрузка данных..." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:StockBalanceDto">
                        <Border Margin="0,3" Padding="10" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White" Stroke="LightGray">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding IngredientName}" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                                    <Label Text="{Binding MinRemaining, StringFormat='Мин. остаток: {0}'}" FontSize="11" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding Balance, StringFormat='{0}'}" 
                                       TextColor="#1976D2" FontAttributes="Bold" FontSize="18" 
                                       VerticalOptions="Center" Margin="0,0,5,0"/>

                                <Label Grid.Column="2" Text="{Binding UnitOfMeasure}" 
                                       TextColor="Gray" VerticalOptions="Center" FontSize="14"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>