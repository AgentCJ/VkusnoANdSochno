<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             xmlns:vm="clr-namespace:VkusnoAndSochno.App.ViewModels"
             x:Class="VkusnoAndSochno.App.Views.StorekeeperPage"
             Title="Склад"
             BackgroundColor="#F5F5F5">

    <Grid>
        <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="10">

            <!-- Верхняя панель -->
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="📥 Принять поставку" Command="{Binding OpenReceiveSupplyCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                    <Button Text="📝 Заявка поставщику" Command="{Binding OpenRequestCommand}" BackgroundColor="#2196F3" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                </HorizontalStackLayout>

                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <SearchBar Placeholder="Поиск продукта..." Text="{Binding SearchText}" BackgroundColor="Transparent" CancelButtonColor="Gray" TextColor="Black" PlaceholderColor="#999999"/>
                </Border>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Button Grid.Column="0" 
                            Text="{Binding SelectedSort, StringFormat='🔽 {0}'}" 
                            Command="{Binding ChangeSortCommand}" 
                            BackgroundColor="#E3F2FD" TextColor="#1565C0" FontSize="13" FontAttributes="Bold" 
                            HeightRequest="40" CornerRadius="5" HorizontalOptions="Start" Padding="15,0"/>

                    <Button Grid.Column="1" 
                            Text="🔄 Обновить" 
                            Command="{Binding LoadDataCommand}" 
                            BackgroundColor="#2196F3" TextColor="White" FontSize="12" 
                            HeightRequest="40" WidthRequest="120" Padding="0" CornerRadius="5"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Список остатков -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredStockList}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:StockBalanceDto">
                            <Border Margin="0" Padding="10" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FFEBEE" />
                                        <Setter Property="Stroke" Value="#F44336" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLowStock}" Value="False">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="Stroke" Value="LightGray" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding IngredientName}" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                                        <Label Text="{Binding MinRemaining, StringFormat='Мин. остаток: {0:0.###}'}" FontSize="11" TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Balance, StringFormat='{0:0.###}'}" TextColor="#1976D2" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding UnitOfMeasure}" TextColor="Gray" VerticalOptions="Center" FontSize="14" Margin="0,0,10,0"/>

                                    <Button Grid.Column="3" Text="🔄" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenAdjustCommand}" CommandParameter="{Binding .}" BackgroundColor="#FFC107" TextColor="Black" WidthRequest="40" HeightRequest="35" FontSize="16" CornerRadius="5" Padding="0" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Окно инвентаризации -->
        <Grid IsVisible="{Binding IsAdjustVisible}" BackgroundColor="#80000000" Padding="20">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Инвентаризация" FontAttributes="Bold" FontSize="20" TextColor="Black" HorizontalOptions="Center"/>
                    <Label Text="{Binding AdjustProductName, StringFormat='Продукт: {0}'}" FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Фактическое количество на складе" FontSize="12" TextColor="Gray"/>
                        <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                            <Entry Keyboard="Numeric" MaxLength="4" Text="{Binding AdjustFactQty}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0" PlaceholderColor="#999999"/>
                        </Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Button Text="💾 Сохранить" Command="{Binding SaveAdjustCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" WidthRequest="140"/>
                        <Button Text="Отмена" Command="{Binding CloseAdjustCommand}" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold" WidthRequest="100"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Окно приемки -->
        <Grid IsVisible="{Binding IsReceiveSupplyVisible}" BackgroundColor="#80000000" Padding="20">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20" VerticalOptions="Center" HeightRequest="500">
                <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">
                    <Label Grid.Row="0" Text="Приемка поставки на склад" FontAttributes="Bold" FontSize="20" TextColor="Black" HorizontalOptions="Center"/>
                    <VerticalStackLayout Grid.Row="1" Spacing="5">
                        <Label Text="Поставщик" FontSize="12" TextColor="Gray"/>
                        <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                            <Picker Title="Выберите поставщика" TitleColor="#999999" ItemsSource="{Binding Suppliers}" ItemDisplayBinding="{Binding SupplierName}" SelectedItem="{Binding SelectedSupplierForReceive}" TextColor="Black" Margin="5,0" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <ScrollView Grid.Row="2">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReceiveList}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReceiveItemDto">
                                    <Grid ColumnDefinitions="*, 100, 40" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding IngredientName}" VerticalOptions="Center" TextColor="Black"/>
                                        <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                            <Entry Placeholder="0" Keyboard="Numeric" MaxLength="4" Text="{Binding QuantityToAdd}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0" PlaceholderColor="#999999"/>
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding UnitOfMeasure}" VerticalOptions="Center" TextColor="Gray"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <HorizontalStackLayout Grid.Row="3" Spacing="10" HorizontalOptions="Center">
                        <Button Text="📥 Принять на склад" Command="{Binding ApplyReceiveSupplyCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
                        <Button Text="Отмена" Command="{Binding CloseReceiveSupplyCommand}" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Окно заявки -->
        <Grid IsVisible="{Binding IsRequestVisible}" BackgroundColor="#80000000" Padding="20">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20" VerticalOptions="Center" HeightRequest="550">
                <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">
                    <Label Grid.Row="0" Text="Создание заявки на поставку" FontAttributes="Bold" FontSize="20" TextColor="Black" HorizontalOptions="Center"/>
                    <VerticalStackLayout Grid.Row="1" Spacing="5">
                        <Label Text="Поставщик" FontSize="12" TextColor="Gray"/>
                        <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                            <Picker Title="Выберите поставщика" TitleColor="#999999" ItemsSource="{Binding Suppliers}" ItemDisplayBinding="{Binding SupplierName}" SelectedItem="{Binding SelectedSupplierForRequest}" TextColor="Black" Margin="5,0" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <ScrollView Grid.Row="2">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RequestList}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RequestItemDto">
                                    <Grid ColumnDefinitions="*, 100, 40" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding IngredientName}" VerticalOptions="Center" TextColor="Black"/>
                                        <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                            <Entry Placeholder="0" Keyboard="Numeric" MaxLength="4" Text="{Binding RequestedQuantity}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0" PlaceholderColor="#999999"/>
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding UnitOfMeasure}" VerticalOptions="Center" TextColor="Gray"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <VerticalStackLayout Grid.Row="3" Spacing="10" HorizontalOptions="Center">
                        <Button Text="📄 Сформировать и сохранить" Command="{Binding GenerateDocxCommand}" BackgroundColor="#2B579A" TextColor="White" FontAttributes="Bold" WidthRequest="250"/>
                        <Button Text="Отмена" Command="{Binding CloseRequestCommand}" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold" WidthRequest="250"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>