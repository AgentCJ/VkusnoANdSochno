<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.StorekeeperPage"
             Title="Склад">
    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Форма поставки -->
        <Border Grid.Row="0" Padding="10" Stroke="Gray" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="5">
                <Label Text="Регистрация поставки" FontAttributes="Bold" FontSize="16"/>

                <Picker Title="Ингредиент" ItemsSource="{Binding Ingredients}" 
                        ItemDisplayBinding="{Binding IngredientName}" 
                        SelectedItem="{Binding SelectedIngredient}" />

                <Picker Title="Поставщик" ItemsSource="{Binding Suppliers}" 
                        ItemDisplayBinding="{Binding SupplierName}" 
                        SelectedItem="{Binding SelectedSupplier}" />

                <Entry Placeholder="Количество" Keyboard="Numeric" Text="{Binding QuantityText}" />

                <Button Text="Оформить поставку" Command="{Binding RegisterSupplyCommand}" BackgroundColor="#4CAF50"/>
                <Label Text="{Binding StatusMessage}" TextColor="DarkSlateBlue" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1" Text="Остатки на складе" FontAttributes="Bold" FontSize="18" Margin="0,10,0,0"/>

        <!-- Таблица остатков -->
        <RefreshView Grid.Row="2" IsRefreshing="False" Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding StockList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:StockBalanceDto">
                        <!-- Подсветка красным, если остаток меньше минимума -->
                        <Border Margin="0,3" Padding="10" StrokeThickness="1" StrokeShape="RoundRectangle 5">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Balance}" Value="0">
                                    <Setter Property="BackgroundColor" Value="#FFCDD2" />
                                </DataTrigger>
                                <!-- Упрощенный триггер: если баланс меньше минимума, красим в красноватый -->
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label Grid.Column="0" Text="{Binding IngredientName}" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Balance, StringFormat='{0} '}" TextColor="Blue" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding UnitOfMeasure}" VerticalOptions="Center" TextColor="Gray"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>