<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.RecipePage"
             Title="Рецепт"
             BackgroundColor="#F5F5F5">
    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Заголовок с названием блюда -->
        <Label Grid.Row="0" Text="{Binding DishName, StringFormat='Рецепт блюда: {0}'}" 
               FontAttributes="Bold" FontSize="20" TextColor="Black"/>

        <!-- Форма добавления ингредиента -->
        <Border Grid.Row="1" Padding="15" BackgroundColor="#E3F2FD" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#90CAF9">
            <Grid ColumnDefinitions="2*, 1*, Auto" ColumnSpacing="10">
                <!-- Ингредиент -->
                <Border Grid.Column="0" Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <Picker Title="Ингредиент" TitleColor="#999999" ItemsSource="{Binding Ingredients}" 
                            ItemDisplayBinding="{Binding IngredientName}" SelectedItem="{Binding SelectedIngredient}"
                            TextColor="Black" Margin="5,0" BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>

                <!-- Количество -->
                <Border Grid.Column="1" Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                    <Entry Placeholder="Кол-во" PlaceholderColor="#999999" Keyboard="Numeric" 
                           Text="{Binding QuantityText}" TextColor="Black" Margin="5,0" BackgroundColor="Transparent"/>
                </Border>

                <Button Grid.Column="2" Text="Добавить" Command="{Binding AddIngredientCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold"/>
            </Grid>
        </Border>

        <!-- Список ингредиентов в рецепте -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding RecipeItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:RecipeItemDto">
                        <Border Margin="0,3" Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 5" Stroke="LightGray" StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{Binding IngredientName}" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center"/>

                                <Label Grid.Column="1" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Quantity}" TextColor="#1976D2" FontAttributes="Bold"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding UnitOfMeasure}" TextColor="Gray"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Button Grid.Column="2" Text="🗑️" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveIngredientCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F44336" TextColor="White" WidthRequest="40" HeightRequest="35" FontSize="16" CornerRadius="5" Padding="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>