<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:VkusnoAndSochno.App.Services"
             x:Class="VkusnoAndSochno.App.Views.AdminPage"
             Title="Управление пользователями"
             BackgroundColor="#F5F5F5">
    <Grid>
        <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="10">

            <!-- Панель кнопок -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="Список учетных записей" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                    <Button Text="➕ Добавить" Command="{Binding OpenCreateFormCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                    <Button Text="🔄 Обновить" Command="{Binding LoadDataCommand}" BackgroundColor="#2196F3" TextColor="White" HeightRequest="40" Padding="10,0" CornerRadius="8"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Список пользователей -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadDataCommand}">
                <CollectionView ItemsSource="{Binding Users}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:AdminUserDto">
                            <Border Margin="0,5" Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="LightGray">
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding EmployeeName}" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                                        <Label Text="{Binding RoleName, StringFormat='Роль: {0}'}" TextColor="#1976D2" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding Login, StringFormat='Логин: {0}'}" TextColor="Gray" FontSize="12"/>
                                        <Label Text="{Binding BranchName, StringFormat='Филиал: {0}'}" TextColor="Gray" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" Text="✏️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditUserCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FFC107" TextColor="Black" WidthRequest="40" HeightRequest="35" FontSize="16" CornerRadius="5" Padding="0" VerticalOptions="Center"/>

                                    <Button Grid.Column="2" 
                                            Text="{Binding IsActive, Converter={StaticResource BoolToBlockTextConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleUserStatusCommand}"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" WidthRequest="120" HeightRequest="35" FontSize="11" FontAttributes="Bold" CornerRadius="5">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFEBEE" />
                                                <Setter Property="TextColor" Value="#D32F2F" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                                <Setter Property="TextColor" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Grid.Column="3" Text="🗑️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteUserCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F44336" TextColor="White" WidthRequest="40" HeightRequest="35" FontSize="16" CornerRadius="5" Padding="0" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Модальное окно добавления/редактирования -->
        <Grid IsVisible="{Binding IsFormVisible}" BackgroundColor="#80000000" Padding="20">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20" VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding FormTitle}" FontAttributes="Bold" FontSize="20" TextColor="Black" HorizontalOptions="Center" Margin="0,0,0,10"/>

                        <!-- ФИО -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ФИО сотрудника" FontSize="12" TextColor="Gray"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                <Entry Text="{Binding InputName}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Телефон -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Телефон" FontSize="12" TextColor="Gray"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                <Entry Text="{Binding InputPhone}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Филиал и Должность -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Филиал" FontSize="12" TextColor="Gray"/>
                                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                    <Picker Title="Выбрать" TitleColor="Gray" ItemsSource="{Binding Branches}" ItemDisplayBinding="{Binding BranchName}" SelectedItem="{Binding SelectedBranch}" TextColor="Black" Margin="5,0"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Должность" FontSize="12" TextColor="Gray"/>
                                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                    <Picker Title="Выбрать" TitleColor="Gray" ItemsSource="{Binding Positions}" ItemDisplayBinding="{Binding PositionName}" SelectedItem="{Binding SelectedPosition}" TextColor="Black" Margin="5,0"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Логин -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Логин" FontSize="12" TextColor="Gray"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                <Entry Text="{Binding InputLogin}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Пароль -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Пароль" FontSize="12" TextColor="Gray"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                <Entry IsPassword="True" Text="{Binding InputPassword}" TextColor="Black" BackgroundColor="Transparent" Margin="5,0" Placeholder="Оставьте пустым, если не меняете" PlaceholderColor="#CCCCCC"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Роль -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Роль в системе" FontSize="12" TextColor="Gray"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White">
                                <Picker Title="Выбрать" TitleColor="Gray" ItemsSource="{Binding Roles}" ItemDisplayBinding="{Binding RoleName}" SelectedItem="{Binding SelectedRole}" TextColor="Black" Margin="5,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,15,0,0">
                            <Button Text="💾 Сохранить" Command="{Binding SaveUserCommand}" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" WidthRequest="140"/>
                            <Button Text="Отмена" Command="{Binding CloseFormCommand}" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold" WidthRequest="100"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>